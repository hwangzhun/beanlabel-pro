    "cors": "^2.8.5",
    "dayjs": "1.11.23",
    "dexie": "4.2.1",
    "dexie-react-hooks": "1.1.7",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.554.0",
    "pdfkit": "^0.15.0",
    "puppeteer": "^24.33.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
