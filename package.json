{
  "name": "beanlabel-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:deploy": "npm run build && node scripts/build-deploy.mjs",
    "preview": "vite preview",
    "server": "node server.js",
