    "test:browser:manage": "node --experimental-strip-types tests/manage-browser.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.7.2",
    "@mantine/dates": "9.7.2",
    "@mantine/hooks": "9.7.2",
